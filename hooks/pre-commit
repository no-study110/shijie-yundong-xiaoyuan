#!/usr/bin/env sh
# git pre-commit 钩子：提交前只跑静态 + 导入检查（约 0.4 秒）。
# 单元测试留给 CI 和手动 `python smoke.py`，否则每次提交要等 2~3 秒。
#
# 安装（在仓库根目录执行一次即可）：
#     git config core.hooksPath hooks
#
# 旁路（确实需要提交未完成代码时）：
#     git commit --no-verify

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# 仓库根有两种可能：整仓就是套件目录，或套件在仓库子目录 协议/7.3.92 下
if [ -f "$root/smoke.py" ]; then
    cd "$root" || exit 0
elif [ -f "$root/协议/7.3.92/smoke.py" ]; then
    cd "$root/协议/7.3.92" || exit 0
else
    exit 0
fi

python smoke.py --skip-tests
