#!/usr/bin/env sh
# git pre-commit 钩子：提交前只跑静态 + 导入检查（约 0.4 秒）。
# 单元测试留给 CI 和手动 `python smoke.py`，否则每次提交要等 2~3 秒。
#
# 安装（在仓库根目录执行一次即可）：
#     git config core.hooksPath 协议/7.3.92/hooks
#
# 旁路（确实需要提交未完成代码时）：
#     git commit --no-verify

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root/协议/7.3.92" || exit 0

python smoke.py --skip-tests
